<UserControl
	x:Class="NOWT.Views.Info"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:p="clr-namespace:NOWT.Properties"
	xmlns:viewModels="clr-namespace:NOWT.ViewModels"
	xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
	d:DesignHeight="754"
	d:DesignWidth="1536"
	UseLayoutRounding="True"
	mc:Ignorable="d"
	d:DataContext="{d:DesignInstance Type=viewModels:InfoViewModel}">
	<UserControl.Resources>
		<Style TargetType="ToolTip">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="{StaticResource BgCard}" />
				</Setter.Value>
			</Setter>
			<Setter Property="Foreground">
				<Setter.Value>
					<SolidColorBrush Color="{StaticResource TextPrimary}" />
				</Setter.Value>
			</Setter>
			<Setter Property="FontFamily" Value="{StaticResource Nunito}" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush">
				<Setter.Value>
					<SolidColorBrush Color="{StaticResource BgGlass}" />
				</Setter.Value>
			</Setter>
			<Setter Property="Padding" Value="10,6" />
			<Setter Property="HasDropShadow" Value="True" />
		</Style>
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation Storyboard.TargetProperty="Opacity"
					                 From="0.0" To="1.0" Duration="0:0:0.6">
						<DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!-- ═══════════ TOP NAV BAR ═══════════ -->
		<Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
		        CornerRadius="16" Padding="8,4"
		        BorderBrush="{StaticResource BgGlassBrush}" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
			</Border.Effect>
			<Grid Height="56">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="0" Cursor="Hand" Width="48" Height="48"
				        ToolTip="{x:Static p:Resources.SettingsTitle}" ToolTipService.InitialShowDelay="0"
				        Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:ImageAwesome PrimaryColor="{StaticResource AccentRed}" Icon="Solid_Gear" Margin="10" />
				</Button>
				<Button Grid.Column="1" Cursor="Hand" Margin="16,4"
				        ToolTip="{x:Static p:Resources.RefreshMatch}" ToolTipService.InitialShowDelay="0"
				        Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
						           FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="{StaticResource AccentRedBrush}"
						           Text="{x:Static p:Resources.Home}" />
					</Viewbox>
				</Button>
				<fa:ImageAwesome Grid.Column="2" PrimaryColor="{StaticResource AccentRed}"
				                 Icon="Solid_Info" Margin="14" Width="24" Height="24" />
			</Grid>
		</Border>

		<!-- ═══════════ HERO CONTENT ═══════════ -->
		<Grid Grid.Row="1">
			<!-- Background glow effects -->
			<Ellipse Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"
			         Margin="0,-40,0,0" Opacity="0.08">
				<Ellipse.Fill>
					<RadialGradientBrush>
						<GradientStop Color="{StaticResource AccentRed}" Offset="0" />
						<GradientStop Color="Transparent" Offset="1" />
					</RadialGradientBrush>
				</Ellipse.Fill>
			</Ellipse>
			<Ellipse Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center"
			         Margin="100,60,0,0" Opacity="0.05">
				<Ellipse.Fill>
					<RadialGradientBrush>
						<GradientStop Color="{StaticResource AccentTeal}" Offset="0" />
						<GradientStop Color="Transparent" Offset="1" />
					</RadialGradientBrush>
				</Ellipse.Fill>
			</Ellipse>

			<!-- Content -->
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0">
				<Button Background="Transparent" BorderThickness="0"
				        Height="120" Cursor="Hand" HorizontalAlignment="Center"
				        RenderOptions.BitmapScalingMode="HighQuality"
				        Click="ImageClickAsync"
				        Tag="https://github.com/pwall2222/NOWT/">
					<Image Source="/Assets/logo.png" />
					<Button.Effect>
						<DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5"
						                  Color="{StaticResource AccentRed}" />
					</Button.Effect>
				</Button>

				<TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
				           FontSize="52" FontWeight="Bold"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="{StaticResource TextPrimaryBrush}"
				           TextWrapping="Wrap">
					NOWT
				</TextBlock>

				<TextBlock HorizontalAlignment="Center" Margin="0,4,0,0"
				           FontSize="22" FontWeight="SemiBold"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="{StaticResource AccentRedBrush}"
				           Text="New Opponent Who This?"
				           TextWrapping="Wrap" />

				<!-- Accent line -->
				<Border Width="60" Height="3" CornerRadius="2" Margin="0,16,0,0"
				        HorizontalAlignment="Center"
				        Background="{StaticResource AccentRedBrush}" Opacity="0.6" />

				<!-- Subtle link -->
				<TextBlock HorizontalAlignment="Center" Margin="0,20,0,0"
				           FontSize="13" FontWeight="Normal"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="{StaticResource TextMutedBrush}"
				           Text="github.com/pwall2222/NOWT" />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
