<UserControl
	x:Class="NOWT.Views.Home"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:c="clr-namespace:NOWT.Controls"
	xmlns:viewmodels="clr-namespace:NOWT.ViewModels"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:p="clr-namespace:NOWT.Properties"
	xmlns:fa="http://schemas.fontawesome.com/icons"
	d:DataContext="{d:DesignInstance Type=viewmodels:HomeViewModel}"
	d:DesignHeight="754"
	d:DesignWidth="1536"
	mc:Ignorable="d">
	<i:Interaction.Triggers>
		<i:EventTrigger EventName="Loaded">
			<i:InvokeCommandAction Command="{Binding PassiveLoadCheckCommand}" />
		</i:EventTrigger>
	</i:Interaction.Triggers>
	<UserControl.Resources>
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0.0" To="1.0" Duration="0:0:0.6">
						<DoubleAnimation.EasingFunction>
							<CubicEase EasingMode="EaseOut" />
						</DoubleAnimation.EasingFunction>
					</DoubleAnimation>
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!-- ═══════════ TOP NAV BAR ═══════════ -->
		<Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
		        CornerRadius="16" Padding="8,4"
		        BorderBrush="{StaticResource BgGlassBrush}" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
			</Border.Effect>
			<Grid Height="56">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- Settings button -->
				<Button Grid.Column="0" Cursor="Hand" Width="48" Height="48"
				        HorizontalAlignment="Left" VerticalAlignment="Center"
				        Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<Viewbox>
						<fa:FontAwesomeImage PrimaryColor="{StaticResource AccentRedBrush}" Icon="Solid_Gear" Margin="0" />
					</Viewbox>
				</Button>

				<!-- Hidden GoMatch button -->
				<Button Grid.Column="0" x:Name="GoMatch"
				        Command="{Binding DataContext.NavigateMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Visibility="Collapsed">
					<Viewbox>
						<fa:FontAwesomeImage PrimaryColor="{StaticResource AccentRedBrush}" Icon="Solid_Gear" Margin="0" />
					</Viewbox>
				</Button>

				<!-- "Your Party" title -->
				<TextBlock Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
				           Margin="16,0,0,0"
				           FontSize="26" FontWeight="Bold"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="{StaticResource TextPrimaryBrush}"
				           Text="{x:Static p:Resources.YourParty}" />

				<!-- "Status" title -->
				<TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
				           Margin="0,0,16,0"
				           FontSize="26" FontWeight="Bold"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="{StaticResource TextPrimaryBrush}"
				           Text="{x:Static p:Resources.Status}" />

				<!-- Info button -->
				<Button Grid.Column="3" Cursor="Hand" Width="48" Height="48"
				        HorizontalAlignment="Right" VerticalAlignment="Center"
				        Command="{Binding DataContext.NavigateInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<Viewbox>
						<fa:FontAwesomeImage PrimaryColor="{StaticResource AccentRedBrush}" Icon="Solid_Info" Margin="0" />
					</Viewbox>
				</Button>
			</Grid>
		</Border>

		<!-- ═══════════ MAIN CONTENT ═══════════ -->
		<Grid Grid.Row="1" Margin="0,16,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!-- ─── LEFT: Player List ─── -->
			<ItemsControl Grid.Column="0" VerticalAlignment="Center"
			              ItemsSource="{Binding PlayerList}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="1" Margin="4" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<c:PlayerControl MaxHeight="150"
						                 Margin="0,5"
						                 PlayerCell="{Binding}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- ─── SEPARATOR ─── -->
			<Border Grid.Column="1" Width="1" Margin="16,24"
			        VerticalAlignment="Stretch"
			        Background="{StaticResource BgGlassBrush}"
				CornerRadius="1" Opacity="0.5" />

			<!-- ─── RIGHT: Status + Refresh ─── -->
			<StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0"
			            Width="380">

				<!-- ═══ Status Card ═══ -->
				<Border Background="{StaticResource BgCardBrush}"
				        CornerRadius="16" Padding="0"
				        BorderBrush="{StaticResource BgGlassBrush}" BorderThickness="1"
				        Margin="0,0,0,16">
					<Border.Effect>
						<DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000" />
					</Border.Effect>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition />
							<RowDefinition />
							<RowDefinition />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<!-- Valorant -->
						<TextBlock Grid.Row="0" Grid.Column="0" Margin="28,20,16,20"
						           FontSize="18" FontWeight="SemiBold"
						           HorizontalAlignment="Left" VerticalAlignment="Center"
						           FontFamily="{StaticResource Nunito}"
						           Foreground="{StaticResource TextPrimaryBrush}"
						           Text="{x:Static p:Resources.Valorant}" />
						<fa:FontAwesomeImage Grid.Row="0" Grid.Column="1"
						                 Height="24" Width="24" x:Name="ValorantStatusView"
						                 PrimaryColor="{StaticResource AccentRedBrush}"
						                 Icon="Solid_Xmark" Margin="16,20,28,20" />

						<!-- Row separator -->
						<Border Grid.Row="0" Grid.ColumnSpan="2"
						        VerticalAlignment="Bottom" Height="1"
						        Margin="20,0"
						        Background="{StaticResource BgGlassBrush}" Opacity="0.4" />

						<!-- Account -->
						<TextBlock Grid.Row="1" Grid.Column="0" Margin="28,20,16,20"
						           FontSize="18" FontWeight="SemiBold"
						           HorizontalAlignment="Left" VerticalAlignment="Center"
						           FontFamily="{StaticResource Nunito}"
						           Foreground="{StaticResource TextPrimaryBrush}"
						           Text="{x:Static p:Resources.Account}" />
						<fa:FontAwesomeImage Grid.Row="1" Grid.Column="1"
						                 Height="24" Width="24" x:Name="AccountStatusView"
						                 PrimaryColor="{StaticResource AccentRedBrush}"
						                 Icon="Solid_Xmark" Margin="16,20,28,20" />

						<!-- Row separator -->
						<Border Grid.Row="1" Grid.ColumnSpan="2"
						        VerticalAlignment="Bottom" Height="1"
						        Margin="20,0"
						        Background="{StaticResource BgGlassBrush}" Opacity="0.4" />

						<!-- Match -->
						<TextBlock Grid.Row="2" Grid.Column="0" Margin="28,20,16,20"
						           FontSize="18" FontWeight="SemiBold"
						           HorizontalAlignment="Left" VerticalAlignment="Center"
						           FontFamily="{StaticResource Nunito}"
						           Foreground="{StaticResource TextPrimaryBrush}"
						           Text="{x:Static p:Resources.Match}" />
						<fa:FontAwesomeImage Grid.Row="2" Grid.Column="1"
						                 Height="24" Width="24" x:Name="MatchStatusView"
						                 PrimaryColor="{StaticResource AccentRedBrush}"
						                 Icon="Solid_Xmark" Margin="16,20,28,20" />
					</Grid>
				</Border>

				<!-- ═══ Refresh Card ═══ -->
				<Border Background="{StaticResource BgCardBrush}"
				        CornerRadius="16" Padding="0"
				        BorderBrush="{StaticResource BgGlassBrush}" BorderThickness="1">
					<Border.Effect>
						<DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000" />
					</Border.Effect>
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Row 1: Refresh label + buttons -->
						<StackPanel Grid.Row="0" Orientation="Horizontal"
						            HorizontalAlignment="Center"
						            Margin="20,18,20,10">
							<TextBlock FontSize="18" FontWeight="SemiBold"
							           VerticalAlignment="Center"
							           Foreground="{StaticResource TextPrimaryBrush}"
							           FontFamily="{StaticResource Nunito}"
							           Text="{x:Static p:Resources.Refresh}"
						           Margin="0,0,16,0" />

							<Button Cursor="Hand" Width="48" Height="48"
							        HorizontalAlignment="Center" VerticalAlignment="Center"
							        Template="{StaticResource ButtonTemplate}"
							        Command="{Binding LoadNowCommand}"
							        Margin="0,0,8,0">
								<fa:FontAwesomeImage PrimaryColor="{StaticResource AccentRedBrush}" Icon="Solid_Rotate" Margin="10" />
							</Button>

							<ToggleButton Cursor="Hand" Width="48" Height="48"
							              HorizontalAlignment="Center" VerticalAlignment="Center"
							              Template="{StaticResource ToggleButtonTemplate}">
								<i:Interaction.Triggers>
									<i:EventTrigger EventName="Checked">
										<i:InvokeCommandAction Command="{Binding Path=StopPassiveLoadAsyncCommand}" />
									</i:EventTrigger>
									<i:EventTrigger EventName="Unchecked">
										<i:InvokeCommandAction Command="{Binding Path=PassiveLoadAsyncCommand}" />
									</i:EventTrigger>
								</i:Interaction.Triggers>
								<fa:FontAwesomeImage PrimaryColor="{StaticResource AccentRedBrush}" Icon="Solid_Pause" Margin="10" />
							</ToggleButton>
						</StackPanel>

						<!-- Separator -->
						<Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
						        Margin="20,0"
						        Background="{StaticResource BgGlassBrush}" Opacity="0.4" />

						<!-- Row 2: Refreshing in countdown -->
						<StackPanel Grid.Row="1" Orientation="Horizontal"
						            HorizontalAlignment="Center"
						            Margin="20,14,20,18">
							<TextBlock FontSize="16" FontWeight="Normal"
							           VerticalAlignment="Center"
							           Foreground="{StaticResource TextSecondaryBrush}"
							           FontFamily="{StaticResource Nunito}"
							           Text="{x:Static p:Resources.RefreshingIn}"
							           Margin="0,0,10,0" />
							<TextBlock FontSize="18" FontWeight="Bold"
							           VerticalAlignment="Center"
							           FontFamily="{StaticResource Nunito}"
							           Foreground="{StaticResource AccentRedBrush}"
							           Text="{Binding RefreshTime}" />
						</StackPanel>
					</Grid>
				</Border>

			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
