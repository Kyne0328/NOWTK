<UserControl x:Class="NOWT.Views.RoundStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:NOWT.Controls"
             xmlns:viewmodels="clr-namespace:NOWT.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:NOWT.Converters"
             xmlns:fa="http://schemas.fontawesome.com/icons/svg"
             xmlns:p="clr-namespace:NOWT.Properties"
             d:DataContext="{d:DesignInstance Type=viewmodels:RoundStatsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="754"
             d:DesignWidth="1536">
	<i:Interaction.Triggers>
		<i:EventTrigger EventName="Loaded">
			<i:InvokeCommandAction Command="{Binding PassiveLoadCheckCommand}" />
		</i:EventTrigger>
		<i:EventTrigger EventName="Closing">
			<i:InvokeCommandAction Command="{Binding StopPassiveLoadAsyncCommand}" />
		</i:EventTrigger>
	</i:Interaction.Triggers>
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
		<converters:RoundResultConverter x:Key="RoundResultConverter" />
		<converters:RoundResultColorConverter x:Key="RoundResultColorConverter" />
		<converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0.0" To="1.0" Duration="0:0:0.6">
						<DoubleAnimation.EasingFunction>
							<CubicEase EasingMode="EaseOut" />
						</DoubleAnimation.EasingFunction>
					</DoubleAnimation>
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!-- ═══════════ GLASSMORPHIC NAV BAR ═══════════ -->
		<Border Grid.Row="0" Background="#1E2140"
		        CornerRadius="16" Padding="8,4"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
			</Border.Effect>
			<Grid Height="56">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- Back -->
				<Button Grid.Column="0" x:Name="GoHome" Width="48" Height="48" Margin="4"
				        Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_AngleLeft" Margin="10" />
				</Button>

				<!-- Settings -->
				<Button Grid.Column="1" Width="48" Height="48" Margin="4"
				        Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_Gear" Margin="10" />
				</Button>

				<!-- Refresh -->
				<Button Grid.Column="2" Width="48" Height="48" Margin="4"
				        IsEnabled="{Binding Path=Overlay.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
				        Command="{Binding GetRoundStatsCommand}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_Rotate" Margin="10" />
				</Button>

				<!-- Pause -->
				<ToggleButton Grid.Column="3" Width="48" Height="48" Margin="4"
				              Template="{StaticResource ToggleButtonTemplate}">
					<i:Interaction.Triggers>
						<i:EventTrigger EventName="Checked">
							<i:InvokeCommandAction Command="{Binding Path=StopPassiveLoadAsyncCommand}" />
						</i:EventTrigger>
						<i:EventTrigger EventName="Unchecked">
							<i:InvokeCommandAction Command="{Binding Path=PassiveLoadAsyncCommand}" />
						</i:EventTrigger>
					</i:Interaction.Triggers>
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_Pause" Margin="10" />
				</ToggleButton>

				<!-- WebSocket Connect -->
				<Button Grid.Column="4" Width="48" Height="48" Margin="4"
				        Command="{Binding ConnectToWebSocketCommand}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="{Binding IsConnected, Converter={StaticResource BooleanToColorConverter}}" 
					               Icon="Solid_Plug" Margin="10" />
				</Button>

				<!-- Countdown -->
				<TextBlock Grid.Column="7" Margin="16,0,4,0"
				           FontSize="15" VerticalAlignment="Center"
				           FontWeight="Normal" FontFamily="{StaticResource Nunito}"
				           Foreground="#8B8FA3"
				           Text="{x:Static p:Resources.RefreshingIn}" />
				<TextBlock Grid.Column="8" Margin="4,0,8,0"
				           FontSize="16" VerticalAlignment="Center"
				           FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FF4655"
				           Text="{Binding RefreshTime}" />

				<!-- Title -->
				<Border Grid.Column="9" HorizontalAlignment="Right"
				        Background="#2A2D52"
				        CornerRadius="14" Padding="12,4" Margin="4"
				        VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_ChartBar" Margin="0,0,8,0" VerticalAlignment="Center"/>
						<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="SemiBold"
						           Margin="0"
						           Foreground="#FFFFFF"
						           HorizontalAlignment="Center" VerticalAlignment="Center"
						           Text="Round Stats" />
					</StackPanel>
				</Border>

				<!-- Placeholder for map/banner -->
				<Border Grid.Column="10" HorizontalAlignment="Right" MinWidth="200"
				        CornerRadius="14" Margin="4" ClipToBounds="True"
				        VerticalAlignment="Center" Height="48"
				        Background="#1E2140">
					<TextBlock FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="Bold"
					           Margin="16,0"
					           Foreground="#8B8FA3"
					           HorizontalAlignment="Left" VerticalAlignment="Center"
					           Text="Current Match" />
				</Border>
			</Grid>
		</Border>

		<!-- ═══════════ ROUND STATS CONTENT ═══════════ -->
		<Grid Grid.Row="1" Margin="0,12,0,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<!-- WebSocket Warning Banner -->
			<Border Grid.Row="0" Background="#3D2A1F" CornerRadius="12" Padding="12" Margin="0,0,0,8"
			        Visibility="{Binding WebSocketTrackingEnabled, Converter={StaticResource InverseBooleanConverter}}">
				<StackPanel Orientation="Horizontal">
					<fa:SvgAwesome PrimaryColor="#FFAA00" Icon="Solid_ExclamationTriangle" Margin="0,0,8,0" VerticalAlignment="Center"/>
					<TextBlock FontFamily="{StaticResource Nunito}" FontSize="12" FontWeight="Normal"
					           Foreground="#FFCC80" Text="WebSocket tracking disabled. Enable in settings for real-time stats." />
				</StackPanel>
			</Border>

			<!-- Header -->
			<Border Grid.Row="1" Background="#2A2D52" CornerRadius="12" Padding="16" Margin="0,0,0,8">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					
					<TextBlock Grid.Column="0" FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="SemiBold"
					           Foreground="#FFFFFF" Text="Round" Margin="0,0,16,0" />
					
					<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
						<TextBlock FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="SemiBold"
						           Foreground="#FF4655" Text="You" Margin="0,0,32,0" />
						<TextBlock FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="SemiBold"
						           Foreground="#FFFFFF" Text="vs" Margin="0,0,32,0" />
						<TextBlock FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="SemiBold"
						           Foreground="#46A0FF" Text="Opponent" />
					</StackPanel>
					
					<TextBlock Grid.Column="2" FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="SemiBold"
					           Foreground="#FFFFFF" Text="Result" />
				</Grid>
			</Border>

			<!-- Round Stats List -->
			<ItemsControl Grid.Row="2" ItemsSource="{Binding RoundStats}" Margin="0">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border Background="#1E2140" CornerRadius="12" Padding="16" Margin="0,4,0,4"
						        BorderBrush="#2A2D52" BorderThickness="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								
								<!-- Round Number -->
								<TextBlock Grid.Column="0" FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Bold"
								           Foreground="#FFFFFF" Text="{Binding RoundNumber}" Margin="0,0,16,0"
								           VerticalAlignment="Center" Width="40" />
								
								<!-- Kills/Deaths Comparison -->
								<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
									<!-- Player Stats -->
									<StackPanel Orientation="Horizontal" Margin="0,0,32,0">
										<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="SemiBold"
										           Foreground="#FF4655" Text="{Binding PlayerKills}" Margin="0,0,4,0" />
										<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Normal"
										           Foreground="#8B8FA3" Text="/" />
										<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="SemiBold"
										           Foreground="#FF4655" Text="{Binding PlayerDeaths}" Margin="4,0,0,0" />
									</StackPanel>
									
									<!-- Divider -->
									<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Normal"
									           Foreground="#8B8FA3" Text="vs" Margin="0,0,32,0" />
									
									<!-- Opponent Stats -->
									<StackPanel Orientation="Horizontal">
										<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="SemiBold"
										           Foreground="#46A0FF" Text="{Binding OpponentKills}" Margin="0,0,4,0" />
										<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="Normal"
										           Foreground="#8B8FA3" Text="/" />
										<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="SemiBold"
										           Foreground="#46A0FF" Text="{Binding OpponentDeaths}" Margin="4,0,0,0" />
									</StackPanel>
								</StackPanel>
								
								<!-- Result Icon -->
								<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
									<fa:SvgAwesome 
									    Width="24" Height="24"
									    Icon="{Binding Converter={StaticResource RoundResultConverter}}"
									    PrimaryColor="{Binding Converter={StaticResource RoundResultColorConverter}}" />
								</StackPanel>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

		<!-- ═══════════ OVERLAY ═══════════ -->
		<controls:OverlayControl Grid.Row="2" Grid.Column="0"
		                         Style="{StaticResource VisibleAnimation}"
		                         Overlay="{Binding Overlay}"
		                         Visibility="{Binding Overlay.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
	</Grid>
</UserControl>
