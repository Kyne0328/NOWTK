<UserControl
	x:Class="NOWT.Views.Settings"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:p="clr-namespace:NOWT.Properties"
	xmlns:viewmodels="clr-namespace:NOWT.ViewModels"
	xmlns:fa="http://schemas.fontawesome.com/icons/fonts"
	d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
	d:DesignHeight="754"
	d:DesignWidth="1536"
	mc:Ignorable="d">

	<UserControl.Resources>
		<!-- Modern ComboBox Toggle -->
		<ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="28" />
				</Grid.ColumnDefinitions>
				<Border x:Name="Border" Grid.ColumnSpan="2"
				        Background="#2A2D52"
				        BorderBrush="#2A2D52"
				        BorderThickness="1" CornerRadius="8" />
				<Border Grid.Column="0" Margin="1"
				        Background="#2A2D52"
				        BorderThickness="0" CornerRadius="8" />
				<Path x:Name="Arrow" Grid.Column="1"
				      HorizontalAlignment="Center" VerticalAlignment="Center"
				      Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z" Fill="White" />
			</Grid>
		</ControlTemplate>

		<ControlTemplate x:Key="ComboBoxTextBox" TargetType="{x:Type TextBox}">
			<Border x:Name="PART_ContentHost" Background="{TemplateBinding Background}" Focusable="False" />
		</ControlTemplate>

		<Style TargetType="{x:Type ComboBox}">
			<Setter Property="SnapsToDevicePixels" Value="true" />
			<Setter Property="OverridesDefaultStyle" Value="true" />
			<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
			<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
			<Setter Property="ScrollViewer.CanContentScroll" Value="true" />
			<Setter Property="MinWidth" Value="120" />
			<Setter Property="MinHeight" Value="20" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBox}">
						<Grid>
							<ToggleButton Name="ToggleButton" Grid.Column="0"
							              ClickMode="Press" Focusable="false"
							              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
							              Template="{StaticResource ComboBoxToggleButton}" />
							<ContentPresenter Name="ContentSite" Margin="8,3,28,3"
							                  HorizontalAlignment="Left" VerticalAlignment="Center"
							                  Content="{TemplateBinding SelectionBoxItem}"
							                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
							                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
							                  IsHitTestVisible="False" />
							<TextBox x:Name="PART_EditableTextBox" Margin="8,3,28,3"
							         HorizontalAlignment="Left" VerticalAlignment="Center"
							         FontFamily="{StaticResource Nunito}"
							         Background="Transparent" Focusable="True" Foreground="White"
							         IsReadOnly="{TemplateBinding IsReadOnly}"
							         Style="{x:Null}" Template="{StaticResource ComboBoxTextBox}"
							         Visibility="Hidden" />
							<Popup Name="Popup" AllowsTransparency="True" Focusable="False"
							       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
							       PopupAnimation="Slide">
								<Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}"
								      MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
									<Border x:Name="DropDownBorder"
									        Background="#1E2140"
									        BorderBrush="#2A2D52"
									        BorderThickness="1" CornerRadius="8" />
									<ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
										<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
									</ScrollViewer>
								</Grid>
							</Popup>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="HasItems" Value="false">
								<Setter TargetName="DropDownBorder" Property="MinHeight" Value="95" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="false">
								<Setter Property="Foreground" Value="#888888" />
							</Trigger>
							<Trigger Property="IsGrouping" Value="true">
								<Setter Property="ScrollViewer.CanContentScroll" Value="false" />
							</Trigger>
							<Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="true">
								<Setter TargetName="DropDownBorder" Property="CornerRadius" Value="8" />
								<Setter TargetName="DropDownBorder" Property="Margin" Value="0,2,0,0" />
							</Trigger>
							<Trigger Property="IsEditable" Value="true">
								<Setter Property="IsTabStop" Value="false" />
								<Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
								<Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="{x:Type ComboBoxItem}">
			<Setter Property="SnapsToDevicePixels" Value="true" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="OverridesDefaultStyle" Value="true" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type ComboBoxItem}">
						<Border Name="Border" Padding="6,4" CornerRadius="4"
						        SnapsToDevicePixels="true">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsHighlighted" Value="true">
								<Setter TargetName="Border" Property="Background">
									<Setter.Value>
										<SolidColorBrush Color="#252850" />
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsEnabled" Value="false">
								<Setter Property="Foreground" Value="#888888" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Settings action button style -->
		<Style x:Key="SettingsActionButton" TargetType="Button">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" CornerRadius="10" Padding="16,8"
						        Background="Transparent"
						        BorderBrush="#555870" BorderThickness="1">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#FF4655" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="#FF4655" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background">
									<Setter.Value>
										<SolidColorBrush Color="#E03040" />
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation Storyboard.TargetProperty="Opacity"
					                 From="0.0" To="1.0" Duration="0:0:0.6">
						<DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
					</DoubleAnimation>
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>

	<Grid Margin="20">
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!-- ═══════════ TOP NAV BAR ═══════════ -->
		<Border Grid.ColumnSpan="3" Background="#1E2140"
		        CornerRadius="16" Padding="8,4"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
			</Border.Effect>
			<Grid Height="56">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<fa:ImageAwesome Grid.Column="0" PrimaryColor="#FF4655" Icon="Solid_Gear"
				                 Margin="14" Width="24" Height="24" VerticalAlignment="Center" />
				<Button Grid.Column="1" Cursor="Hand" Margin="16,4"
				        Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<Viewbox HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
						           FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="#FF4655"
						           Text="{x:Static p:Resources.Home}" />
					</Viewbox>
				</Button>
				<Button Grid.Column="2" Cursor="Hand" Width="48" Height="48"
				        Command="{Binding DataContext.NavigateInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:ImageAwesome PrimaryColor="#FF4655" Icon="Solid_Info" Margin="10" />
				</Button>
			</Grid>
		</Border>

		<!-- ═══════════ SETTINGS CARDS ═══════════ -->

		<!-- Language Card -->
		<Border Grid.Row="1" Grid.Column="0" Margin="0,16,8,8"
		        Background="#1E2140" CornerRadius="16"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000" />
			</Border.Effect>
			<Viewbox>
				<Grid Margin="20" MinWidth="200">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
					           FontWeight="Bold" FontFamily="{StaticResource Nunito}"
					           Foreground="#FFFFFF"
					           Text="{x:Static p:Resources.SelLanguageTitle}"
					           TextAlignment="Center" TextWrapping="Wrap" />
					<Border Grid.Row="1" Height="30" Margin="16,16,16,0" Padding="4"
					        Background="#2A2D52" CornerRadius="8">
						<ComboBox Name="LanguageCombo"
						          HorizontalContentAlignment="Center"
						          Background="Transparent" BorderThickness="0"
						          DropDownOpened="LanguageList_OnDropDownOpenedAsync"
						          SelectionChanged="ListBox_SelectedAsync" />
					</Border>
				</Grid>
			</Viewbox>
		</Border>

		<!-- Force Download Card -->
		<Border Grid.Row="2" Grid.Column="0" Margin="0,8,8,0"
		        Background="#1E2140" CornerRadius="16"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000" />
			</Border.Effect>
			<Grid Margin="16">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
				           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FFFFFF"
				           Text="{x:Static p:Resources.CheckDownloadTitle}" TextWrapping="Wrap" />
				<Viewbox Grid.Row="1" HorizontalAlignment="Center">
					<Button Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"
					        Click="Button_Click5Async" Style="{StaticResource SettingsActionButton}">
						<TextBlock Padding="4" FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="#FF4655"
						           Text="{x:Static p:Resources.CheckDownloadButton}" />
					</Button>
				</Viewbox>
				<Viewbox Grid.Row="2">
					<Button Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"
					        Click="Button_Click4Async" Style="{StaticResource SettingsActionButton}">
						<TextBlock Padding="4" FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="#FF4655"
						           Text="{x:Static p:Resources.CheckUpdates}" />
					</Button>
				</Viewbox>
			</Grid>
		</Border>

		<!-- Info Explanation Card -->
		<Border Grid.Row="1" Grid.Column="1" Margin="8,16,8,8"
		        Background="#1E2140" CornerRadius="16"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000" />
			</Border.Effect>
			<Grid Margin="16">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
				           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FFFFFF"
				           Text="{x:Static p:Resources.InfoTitle}" TextWrapping="Wrap" />
				<Viewbox Grid.Row="1" VerticalAlignment="Top">
					<TextBlock Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
					           Margin="16,0" FontSize="18" FontWeight="Light"
					           FontFamily="{StaticResource Nunito}"
					           Foreground="#8B8FA3" Opacity="0.8"
					           Text="{x:Static p:Resources.SettingsInfoExplanation1}"
					           TextAlignment="Center" TextWrapping="Wrap" />
				</Viewbox>
				<Viewbox Grid.Row="2" VerticalAlignment="Top">
					<TextBlock Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
					           Margin="16,0" FontSize="18" FontWeight="Normal"
					           FontFamily="{StaticResource Nunito}"
					           Foreground="#555870" Opacity="0.5"
					           Text="{x:Static p:Resources.SettingsInfoExplanation2}"
					           TextAlignment="Center" TextWrapping="Wrap" />
				</Viewbox>
			</Grid>
		</Border>

		<!-- Auto Login Card -->
		<Border Grid.Row="1" Grid.Column="2" Margin="8,16,0,8"
		        Background="#1E2140" CornerRadius="16"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000" />
			</Border.Effect>
			<Grid Margin="16">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
				           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FFFFFF"
				           Text="{x:Static p:Resources.AutoLoginTitle}" TextWrapping="Wrap" />
				<Viewbox Grid.Row="1" HorizontalAlignment="Center">
					<TextBlock Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
					           Margin="16,4" FontSize="18" FontWeight="Normal"
					           FontFamily="{StaticResource Nunito}"
					           Foreground="#8B8FA3" Opacity="0.8"
					           Text="{x:Static p:Resources.AutoLoginExplanation}" TextWrapping="Wrap" />
				</Viewbox>
				<Viewbox Grid.Row="2">
					<Button Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"
					        Click="Button_Click3Async" Style="{StaticResource SettingsActionButton}">
						<TextBlock Padding="4" FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="#FF4655"
						           Text="{x:Static p:Resources.Login}" />
					</Button>
				</Viewbox>
			</Grid>
		</Border>

		<!-- Check Updates Card -->
		<Border Grid.Row="2" Grid.Column="2" Margin="8,8,0,0"
		        Background="#1E2140" CornerRadius="16"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000" />
			</Border.Effect>
			<Grid Margin="16">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
				           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FFFFFF"
				           Text="{x:Static p:Resources.CheckUpdates}" TextWrapping="Wrap" />
				<StackPanel Grid.Row="1">
					<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
						<TextBlock FontSize="15" FontFamily="{StaticResource Nunito}"
						           Foreground="#8B8FA3" Opacity="0.8"
						           Text="{x:Static p:Resources.Latestversion}" TextWrapping="Wrap" />
						<TextBlock x:Name="LatestVersion" FontSize="15"
						           Foreground="#8B8FA3" Opacity="0.8"
						           FontFamily="{StaticResource Nunito}" Text="" TextWrapping="Wrap" />
					</StackPanel>
					<StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
						<TextBlock FontSize="15" FontFamily="{StaticResource Nunito}"
						           Foreground="#8B8FA3" Opacity="0.8"
						           Text="{x:Static p:Resources.CurrentVersion}" TextWrapping="Wrap" />
						<TextBlock x:Name="CurrentVersion" FontSize="15"
						           FontFamily="{StaticResource Nunito}"
						           Foreground="#8B8FA3" Opacity="0.8"
						           Text="" TextWrapping="Wrap" />
					</StackPanel>
				</StackPanel>
				<Viewbox Grid.Row="2">
					<Button Margin="16,4" HorizontalAlignment="Center" VerticalAlignment="Top"
					        Click="Button_Click1Async" Style="{StaticResource SettingsActionButton}">
						<TextBlock Padding="4" FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="#FF4655"
						           Text="{x:Static p:Resources.CheckUpdates}" />
					</Button>
				</Viewbox>
			</Grid>
		</Border>

		<!-- Auth Status Card -->
		<Border Grid.Row="2" Grid.Column="1" Margin="8,8,8,0"
		        Background="#1E2140" CornerRadius="16"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" Color="#000000" />
			</Border.Effect>
			<Grid Margin="16">
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition Height="Auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
				           FontSize="22" FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FFFFFF"
				           Text="{x:Static p:Resources.AuthStatusTitle}" TextWrapping="Wrap" />
				<Viewbox Grid.Row="1" HorizontalAlignment="Center">
					<TextBlock x:Name="AuthStatusBox" Margin="16,4"
					           FontFamily="{StaticResource Nunito}" FontSize="10" FontWeight="Normal"
					           Foreground="#32E2B2" Opacity="0.8"
					           Text="{x:Static p:Resources.AuthStatusDefault}" TextWrapping="Wrap" />
				</Viewbox>
				<Viewbox Grid.Row="2">
					<Button Margin="16,4" HorizontalAlignment="Center" VerticalAlignment="Top"
					        Click="Button_Click2Async" Style="{StaticResource SettingsActionButton}">
						<TextBlock Padding="4" FontFamily="{StaticResource Nunito}" FontWeight="SemiBold"
						           Foreground="#FF4655"
						           Text="{x:Static p:Resources.AuthStatusButton}" />
					</Button>
				</Viewbox>
			</Grid>
		</Border>
	</Grid>
</UserControl>
