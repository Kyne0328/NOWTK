<UserControl x:Class="NOWT.Views.Match"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:NOWT.Controls"
             xmlns:viewmodels="clr-namespace:NOWT.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:NOWT.Converters"
             xmlns:fa="http://schemas.fontawesome.com/icons/svg"
             xmlns:p="clr-namespace:NOWT.Properties"
             d:DataContext="{d:DesignInstance Type=viewmodels:MatchViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="754"
             d:DesignWidth="1536">
	<i:Interaction.Triggers>
		<i:EventTrigger EventName="Loaded">
			<i:InvokeCommandAction Command="{Binding PassiveLoadCheckCommand}" />
		</i:EventTrigger>
		<i:EventTrigger EventName="Closing">
			<i:InvokeCommandAction Command="{Binding StopPassiveLoadAsyncCommand}" />
		</i:EventTrigger>
	</i:Interaction.Triggers>
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
	</UserControl.Resources>
	<UserControl.Triggers>
		<EventTrigger RoutedEvent="Loaded">
			<BeginStoryboard>
				<Storyboard>
					<DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0.0" To="1.0" Duration="0:0:0.6">
						<DoubleAnimation.EasingFunction>
							<CubicEase EasingMode="EaseOut" />
						</DoubleAnimation.EasingFunction>
					</DoubleAnimation>
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!-- ═══════════ GLASSMORPHIC NAV BAR ═══════════ -->
		<Border Grid.Row="0" Background="#1E2140"
		        CornerRadius="16" Padding="8,4"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000" />
			</Border.Effect>
			<Grid Height="56">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- Back -->
				<Button Grid.Column="0" x:Name="GoHome" Width="48" Height="48" Margin="4"
				        Command="{Binding DataContext.NavigateHomeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_AngleLeft" Margin="10" />
				</Button>

				<!-- Settings -->
				<Button Grid.Column="1" Width="48" Height="48" Margin="4"
				        Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_Gear" Margin="10" />
				</Button>

				<!-- Refresh -->
				<Button Grid.Column="2" Width="48" Height="48" Margin="4"
				        IsEnabled="{Binding Path=Overlay.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
				        Command="{Binding GetMatchInfoCommand}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_Rotate" Margin="10" />
				</Button>

				<!-- Pause -->
				<ToggleButton Grid.Column="3" Width="48" Height="48" Margin="4"
				              Template="{StaticResource ToggleButtonTemplate}">
					<i:Interaction.Triggers>
						<i:EventTrigger EventName="Checked">
							<i:InvokeCommandAction Command="{Binding Path=StopPassiveLoadAsyncCommand}" />
						</i:EventTrigger>
						<i:EventTrigger EventName="Unchecked">
							<i:InvokeCommandAction Command="{Binding Path=PassiveLoadAsyncCommand}" />
						</i:EventTrigger>
					</i:Interaction.Triggers>
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_Pause" Margin="10" />
				</ToggleButton>

				<!-- Round Stats -->
				<Button Grid.Column="4" Width="48" Height="48" Margin="4"
				        Command="{Binding DataContext.NavigateRoundStatsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
				        Template="{StaticResource ButtonTemplate}">
					<fa:SvgAwesome PrimaryColor="#FF4655" Icon="Solid_ChartBar" Margin="10" />
				</Button>

				<!-- Countdown -->
				<TextBlock Grid.Column="6" Margin="16,0,4,0"
				           FontSize="15" VerticalAlignment="Center"
				           FontWeight="Normal" FontFamily="{StaticResource Nunito}"
				           Foreground="#8B8FA3"
				           Text="{x:Static p:Resources.RefreshingIn}" />
				<TextBlock Grid.Column="7" Margin="4,0,8,0"
				           FontSize="16" VerticalAlignment="Center"
				           FontWeight="Bold" FontFamily="{StaticResource Nunito}"
				           Foreground="#FF4655"
				           Text="{Binding RefreshTime}" />

				<!-- Game Mode Pill -->
				<Border Grid.Column="8" HorizontalAlignment="Right"
				        Background="#2A2D52"
				        CornerRadius="14" Padding="12,4" Margin="4"
				        VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<Image Height="24" Width="24" Source="{Binding Path=Match.GameModeImage}"
						       RenderOptions.BitmapScalingMode="HighQuality" />
						<TextBlock FontFamily="{StaticResource Nunito}" FontSize="16" FontWeight="SemiBold"
						           Margin="8,0,0,0"
						           Foreground="#FFFFFF"
						           HorizontalAlignment="Center" VerticalAlignment="Center"
						           Text="{Binding Path=Match.GameMode}" />
					</StackPanel>
				</Border>

				<!-- Map Banner -->
				<Border Grid.Column="8" HorizontalAlignment="Right" MinWidth="200"
				        CornerRadius="14" Margin="4" ClipToBounds="True"
				        VerticalAlignment="Center" Height="48">
					<Border.Background>
						<ImageBrush Stretch="UniformToFill" ImageSource="{Binding Path=Match.MapImage}" />
					</Border.Background>
					<Border CornerRadius="14">
						<Border.Background>
							<LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Color="#CC0F1123" Offset="0" />
								<GradientStop Color="#660F1123" Offset="0.5" />
								<GradientStop Color="#330F1123" Offset="1" />
							</LinearGradientBrush>
						</Border.Background>
						<TextBlock FontFamily="{StaticResource Nunito}" FontSize="18" FontWeight="Bold"
						           Margin="16,0"
						           Foreground="#FFFFFF"
						           HorizontalAlignment="Left" VerticalAlignment="Center"
						           Text="{Binding Path=Match.Map}" />
					</Border>
				</Border>
			</Grid>
		</Border>

		<!-- ═══════════ TEAM COLUMNS ═══════════ -->
		<Grid Grid.Row="1" Margin="0,12,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!-- Left Team -->
			<ItemsControl Grid.Column="0" ItemsSource="{Binding LeftPlayerList}" Margin="4">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="1" Margin="4" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<controls:EnhancedPlayerControl MaxHeight="160"
						                        Margin="0,4"
						                        PlayerCell="{Binding}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Glass Divider -->
			<Border Grid.Column="1" Width="2" Margin="8,20"
			        VerticalAlignment="Stretch" CornerRadius="1">
				<Border.Background>
					<LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
						<GradientStop Color="#002A2D52" Offset="0" />
						<GradientStop Color="#FF2A2D52" Offset="0.3" />
						<GradientStop Color="#FF2A2D52" Offset="0.7" />
						<GradientStop Color="#002A2D52" Offset="1" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>

			<!-- Right Team -->
			<ItemsControl Grid.Column="2" ItemsSource="{Binding RightPlayerList}" Margin="4">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="1" Margin="4" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<controls:EnhancedPlayerControl MaxHeight="160"
						                        Margin="0,4"
						                        PlayerCell="{Binding}" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Grid>

		<!-- ═══════════ OVERLAY ═══════════ -->
		<controls:OverlayControl Grid.Row="1" Grid.Column="0"
		                         Style="{StaticResource VisibleAnimation}"
		                         Overlay="{Binding Overlay}"
		                         Visibility="{Binding Overlay.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
	</Grid>
</UserControl>
