<UserControl x:Class="NOWT.Controls.OverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:p="clr-namespace:NOWT.Properties"
             xmlns:fa="http://schemas.fontawesome.com/icons"
             x:Name="Self"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignData OverlayControl}">
	<Grid>
		<!-- Backdrop blur simulation -->
		<Border Background="#CC0F1123" />

		<Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="Auto" Height="Auto"
		        Background="#1E2140" Padding="32"
		        CornerRadius="20"
		        BorderBrush="#2A2D52" BorderThickness="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#000000" />
			</Border.Effect>
			<StackPanel>
				<TextBlock Text="{Binding Overlay.Header, ElementName=Self}"
				           FontSize="24" FontWeight="Bold"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="#FF4655"
				           Padding="5" HorizontalAlignment="Center" />

				<fa:FontAwesomeImage PrimaryColor="#FF4655"
				                 Icon="Solid_YinYang" Spin="True" SpinDuration="2"
				                 Height="80" Width="80" Margin="0,16" />

				<TextBlock Margin="5,0,5,12"
				           Text="{Binding Overlay.Content, ElementName=Self}"
				           FontFamily="{StaticResource Nunito}"
				           Foreground="#8B8FA3"
				           FontSize="14" HorizontalAlignment="Center" />

				<ProgressBar Style="{DynamicResource CustomProgressBar}"
				             Value="{Binding Overlay.Progress, ElementName=Self}"
				             Height="6" Width="220">
				</ProgressBar>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
